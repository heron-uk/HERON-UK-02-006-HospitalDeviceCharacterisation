library(httr2)
library(jsonlite)
get_eudamed_udi <- function(udi) {
url <- paste0(
"https://api.datalake.sante.service.ec.europa.eu",
"/eudamed/udi"
)
response <- request(url) |>
req_url_query(
`api-version` = "v1.0",
format = "json",
PRIMARY_DI = udi
) |>
req_perform()
result <- resp_body_json(response, simplifyVector = TRUE)
if (is.null(result$value) || NROW(result$value) == 0) {
message("No device found for UDI: ", udi)
return(NULL)
}
return(result$value)
}
get_eudamed_udi("01234567890128")
get_eudamed_udi <- function(udi) {
url <- paste0(
"https://api.datalake.sante.service.ec.europa.eu",
"/eudamed/udi"
)
response <- request(url) |>
req_url_query(
PRIMARY_DI = udi,
format = "json",
`api-version` = "v1.0"
) |>
req_error(is_error = function(resp) FALSE) |>
req_perform()
status <- resp_status(response)
if (status != 200) {
message("HTTP status: ", status)
message("Server response:")
cat(resp_body_string(response), "\n")
return(NULL)
}
result <- resp_body_json(
response,
simplifyVector = TRUE
)
if (is.null(result$value) ||
length(result$value) == 0) {
message("No matching UDI found.")
return(NULL)
}
return(result$value)
}
get_eudamed_udi("01234567890128")
get_eudamed_udi(00802526587733)
get_eudamed_udi("00802526587733")
